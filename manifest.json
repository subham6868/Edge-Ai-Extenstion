{
  "manifest_version": 3,
  "name": "Edge Eye AI Firewall",
  "version": "2.0",
  "description": "Analyzes Terms & Conditions pages using AI for each website",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
